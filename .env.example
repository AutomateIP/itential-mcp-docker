# =============================================================================
# Itential MCP Server - Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and configure the values for your environment
# 
# Required variables are marked with [REQUIRED]
# Optional variables have default values shown in [brackets]

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Transport protocol for MCP server [sse]
# Options: stdio, sse, streamable-http
ITENTIAL_MCP_SERVER_TRANSPORT=sse

# Server host address [0.0.0.0]
ITENTIAL_MCP_SERVER_HOST=0.0.0.0

# Server port [8000]
ITENTIAL_MCP_SERVER_PORT=8000

# External port mapping for Docker [8000]
# This is the port you'll access from outside Docker
ITENTIAL_MCP_PORT=8000

# Log level [INFO]
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
ITENTIAL_MCP_SERVER_LOG_LEVEL=INFO

# =============================================================================
# TOOL FILTERING (OPTIONAL)
# =============================================================================

# Include only tools with these tags (comma-separated)
# Leave empty to include all tools
ITENTIAL_MCP_SERVER_INCLUDE_TAGS=

# Exclude tools with these tags (comma-separated) [experimental,beta]
# Common exclusions: experimental, beta, deprecated
ITENTIAL_MCP_SERVER_EXCLUDE_TAGS=experimental,beta

# =============================================================================
# ITENTIAL PLATFORM CONNECTION [REQUIRED]
# =============================================================================

# Itential Platform hostname or IP address [REQUIRED]
# Example: platform.company.com or 192.168.1.100
ITENTIAL_MCP_PLATFORM_HOST=your-platform-host.com

# Platform port [0 = auto-detect]
# Set to 0 for auto-detection, or specify port (e.g., 443, 8080)
ITENTIAL_MCP_PLATFORM_PORT=0

# Disable TLS/SSL [false]
# Set to true only for development environments
ITENTIAL_MCP_PLATFORM_DISABLE_TLS=false

# Disable certificate verification [false]
# Set to true for self-signed certificates (not recommended for production)
ITENTIAL_MCP_PLATFORM_DISABLE_VERIFY=false

# Connection timeout in seconds [30]
ITENTIAL_MCP_PLATFORM_TIMEOUT=30

# =============================================================================
# AUTHENTICATION - OAUTH (RECOMMENDED)
# =============================================================================

# OAuth Client ID [REQUIRED for OAuth]
# Obtain from Itential Platform OAuth configuration
ITENTIAL_MCP_PLATFORM_CLIENT_ID=your-oauth-client-id

# OAuth Client Secret [REQUIRED for OAuth]
# Obtain from Itential Platform OAuth configuration
ITENTIAL_MCP_PLATFORM_CLIENT_SECRET=your-oauth-client-secret

# =============================================================================
# AUTHENTICATION - BASIC AUTH (ALTERNATIVE)
# =============================================================================
# Use these if OAuth is not available
# Leave empty if using OAuth authentication

# Username for basic authentication
ITENTIAL_MCP_PLATFORM_USER=

# Password for basic authentication
ITENTIAL_MCP_PLATFORM_PASSWORD=

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Development Environment Example:
# ITENTIAL_MCP_PLATFORM_HOST=localhost
# ITENTIAL_MCP_PLATFORM_PORT=3000
# ITENTIAL_MCP_PLATFORM_DISABLE_TLS=true
# ITENTIAL_MCP_PLATFORM_DISABLE_VERIFY=true
# ITENTIAL_MCP_PLATFORM_USER=admin
# ITENTIAL_MCP_PLATFORM_PASSWORD=admin

# Production Environment Example:
# ITENTIAL_MCP_PLATFORM_HOST=platform.company.com
# ITENTIAL_MCP_PLATFORM_PORT=443
# ITENTIAL_MCP_PLATFORM_DISABLE_TLS=false
# ITENTIAL_MCP_PLATFORM_DISABLE_VERIFY=false
# ITENTIAL_MCP_PLATFORM_CLIENT_ID=prod-client-id
# ITENTIAL_MCP_PLATFORM_CLIENT_SECRET=prod-client-secret

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
# 
# Connection Issues:
# - Verify ITENTIAL_MCP_PLATFORM_HOST is accessible from Docker container
# - Check firewall rules and network connectivity
# - For local development, use host.docker.internal instead of localhost
# 
# Authentication Issues:
# - Verify OAuth credentials are correct and active
# - Check that OAuth client has necessary permissions
# - For basic auth, ensure user account has API access
# 
# SSL/TLS Issues:
# - Set ITENTIAL_MCP_PLATFORM_DISABLE_VERIFY=true for self-signed certificates
# - Set ITENTIAL_MCP_PLATFORM_DISABLE_TLS=true for HTTP-only connections
# 
# Performance Issues:
# - Increase ITENTIAL_MCP_PLATFORM_TIMEOUT for slow networks
# - Adjust Docker resource limits in docker-compose.yml
